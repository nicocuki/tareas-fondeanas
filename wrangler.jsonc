// Configuración de Cloudflare: la página (dist/) y el servidor de salas en un mismo Worker.
// Cloudflare lo publica solo con cada push a GitHub (Workers Builds): build `npm run build`,
// deploy `npx wrangler deploy`.
{
  "name": "tareas-fondeanas",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALA", "class_name": "Sala" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  "observability": { "enabled": true }
}
