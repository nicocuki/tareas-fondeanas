# Los archivos de /assets llevan un hash en el nombre: se pueden guardar para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El diccionario de La Mecha cambia poco: un día en caché.
/mecha/*
  Cache-Control: public, max-age=86400

# Mario vs Luigi (compilación de Unity): los nombres no cambian entre versiones, un día en caché.
# La página (/mvl/) no: lleva el puente a Photon y tiene que llegar al toque cuando cambia.
/mvl/Build/*
  Cache-Control: public, max-age=86400
/mvl/StreamingAssets/*
  Cache-Control: public, max-age=86400
/mvl/TemplateData/*
  Cache-Control: public, max-age=86400
/mvl/
  Cache-Control: no-cache
